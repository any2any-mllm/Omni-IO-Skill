# Omni-IO — API Keys
# Usage: cp config/.env.example config/.env, then enter your real keys.
# .env is ignored by .gitignore and will not be committed to the repository.
#
# Each modality's provider is set in config/config.yaml.
# See setup/api_guide.md for instructions.
#
# Cost legend:
#   🆓 Completely free; no key required
#   🟢 Free tier available upon registration
#   💰 Paid service

# ════════════════════════════════════════
# Image generation
# ════════════════════════════════════════

# 🟢 fal.ai — FLUX.1-schnell (US$10 free credit for new users; about US$0.003/image)
# This is the default option in config.yaml.
# Get a key: https://fal.ai → Register → API Keys
FAL_API_KEY=

# 💰 OpenAI — gpt-image-2 (about US$0.04/image) + image understanding (gpt-4o) + Whisper ASR
# Get a key: https://platform.openai.com → API Keys
OPENAI_API_KEY=

# ════════════════════════════════════════
# Video generation
# ════════════════════════════════════════

# 💰 DashScope — Wan2.7 video generation (free allowance for new users)
# This is the default option in config.yaml.
# Get a key: https://dashscope.aliyuncs.com (mainland China) or https://bailian.console.aliyun.com (international) → Register → API Key Management
WAN_API_KEY=
# ⚠️ Required for the international service (Singapore): In the Model Studio console,
# use the upper-left menu → Workspace ID. Format: ws-xxxxxxxxxxxxxxxx
# May be left blank for the mainland China service.
WAN_WORKSPACE_ID=

# 🟢 fal.ai — Kling 1.6 video generation (uses FAL_API_KEY; no additional registration)

# ════════════════════════════════════════
# Music generation
# ════════════════════════════════════════

# 🟢 ElevenLabs — Eleven Music v2 (the default in config.yaml; uses ELEVENLABS_API_KEY below)
# A paid subscription is required to unlock Music API access; free/basic plans may return HTTP 401/403.
# Without Music access, switch generate.music.provider in config.yaml back to huggingface or replicate.

# 🟢 Hugging Face — MusicGen (free inference allowance; fallback provider)
# Get a key: https://huggingface.co → Register → Settings → Access Tokens
HUGGINGFACE_API_KEY=

# 💰 Replicate — MusicGen Large (pay-as-you-go; about US$0.0023 per second of audio)
# No cold-start latency, up to 60 seconds, and higher quality than free Hugging Face inference.
# Get a key: https://replicate.com → Register → Account → API tokens
REPLICATE_API_TOKEN=

# ════════════════════════════════════════
# Sound-effect generation
# ════════════════════════════════════════

# 🟢 ElevenLabs — Sound Effects + TTS + Music (free monthly allowance; paid subscription required for Music API)
# Get a key: https://elevenlabs.io → Register → Profile → API Key
ELEVENLABS_API_KEY=

# ════════════════════════════════════════
# Speech synthesis (TTS)
# ════════════════════════════════════════

# 🆓 edge-tts — Microsoft Edge TTS, completely free; no key required
# This is the default option in config.yaml; nothing needs to be configured here.

# 💰 OpenAI TTS — tts-1, US$0.015 per 1K characters (uses OPENAI_API_KEY)

# 🟢 ElevenLabs TTS — Free tier available (uses ELEVENLABS_API_KEY)

# ════════════════════════════════════════
# Public file hosting (Cloudinary)
# ════════════════════════════════════════

# 🟢 Cloudinary — Converts local files into public URLs (required for Meshy image-to-3D)
# Free tier: 25 GB/month; no credit card required
# Get credentials: cloudinary.com → Register → Dashboard → Copy Cloud name / API Key / API Secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ════════════════════════════════════════
# 3D generation
# ════════════════════════════════════════

# 🟢 Tripo3D — Tripo v2 (free credits upon registration)
# This is the default option in config.yaml.
# Get a key: https://www.tripo3d.ai → Register → API
TRIPO_API_KEY=

# 🟢 Meshy — Meshy v2 (free tier available)
# Get a key: https://www.meshy.ai → Register → API Keys
MESHY_API_KEY=

# ════════════════════════════════════════
# Understanding tools
# ════════════════════════════════════════

# 🟢 Gemini — Preferred path for video + audio understanding (Gemini 2.5 Flash; 1M tokens free per day)
# Get a key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# 🟢 Mistral — Document OCR (free tier available)
# Get a key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# 🟢 Qwen2-Audio — Music/environmental-sound analysis (DashScope; free allowance available)
# Uses the same Alibaba Cloud DashScope platform as WAN_API_KEY; the same key may be used.
# Get a key: https://dashscope.aliyuncs.com → Register → API Key Management
QWEN_API_KEY=

# ════════════════════════════════════════
# Utilities
# ════════════════════════════════════════

# 🟢 Brave Search — Web search (2,000 free requests per month)
# Get a key: https://brave.com/search/api → Register
SEARCH_API_KEY=

# ════════════════════════════════════════
# Optional: Microsoft Graph (enhanced Office documents)
# 🆓 When omitted, full-featured local generation uses python-pptx/python-docx.
# ════════════════════════════════════════
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
